<Project>
  <PropertyGroup>
    <!-- No Windows SDK version in the framework: CallDock uses no WinRT APIs, and a versioned framework would ship the
         25 MB WinRT projection. Features of newer Windows (sound of one application) are checked at run time. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14</LangVersion>
    <!-- 64-bit Windows only: every project builds as x64, so all outputs live under bin\x64\(configuration). -->
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Restored up front, so the locked restore in CI also covers the self-contained release. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- The interface is Russian: framework messages in Russian, no other translations in the build. -->
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Version>1.0.1</Version>
    <Company>CallDock</Company>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
