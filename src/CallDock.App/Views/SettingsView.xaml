<UserControl x:Class="CallDock.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <UserControl.Resources>
    <Style x:Key="Group" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
      <Setter Property="Margin" Value="0,26,0,10" />
    </Style>
    <Style x:Key="Row" TargetType="Border" BasedOn="{StaticResource Surface}">
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,22,32,32" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Text="Настройки" Style="{StaticResource PageTitle}" />
      <TextBlock Text="Всё сохраняется сразу. Записи, модели и настройки хранятся только на этом компьютере." Style="{StaticResource Caption}" Margin="0,4,0,0" />

      <!-- Speech -->
      <TextBlock Text="Распознавание речи" Style="{StaticResource Group}" />
      <TextBlock Text="Модель скачивается один раз и работает без интернета: звук никуда не отправляется. Выберите модель — ею будут расшифровываться новые записи."
                 Style="{StaticResource Caption}" Margin="0,-4,0,10" />
      <ItemsControl ItemsSource="{Binding Models}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Row}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <RadioButton GroupName="Model" IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding SelectCommand}" VerticalAlignment="Center"
                             MinWidth="0" Width="28" Padding="0" Margin="0,0,12,0" AutomationProperties.Name="{Binding Title}" ToolTip="Использовать эту модель" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  ·  " /><Run Text="{Binding Size, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  </TextBlock>
                  <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" Margin="0,4,0,0" Visibility="{Binding IsRecommended, Converter={StaticResource Visible}}">
                    <TextBlock Text="Подходит этому компьютеру" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                  </Border>
                  <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                  <TextBlock Text="{Binding State}" FontSize="12" Margin="0,4,0,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <ProgressBar Height="4" Margin="0,6,0,0" Maximum="100" Value="{Binding Progress}" Visibility="{Binding IsDownloading, Converter={StaticResource Visible}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                  <ui:Button Content="Скачать" Command="{Binding DownloadCommand}" Appearance="Primary"
                             Visibility="{Binding IsInstalled, Converter={StaticResource Hidden}}" IsEnabled="{Binding IsDownloading, Converter={StaticResource Not}}">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowDownload24" /></ui:Button.Icon>
                  </ui:Button>
                  <ui:Button Content="Отмена" Command="{Binding CancelCommand}" Margin="8,0,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource Visible}}" />
                  <ui:Button Content="Удалить" Command="{Binding DeleteCommand}" Appearance="Transparent" Visibility="{Binding IsInstalled, Converter={StaticResource Visible}}"
                             ToolTip="Освободить место; модель можно скачать снова" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Style="{StaticResource Row}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Язык разговора" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Если говорят на одном языке, укажите его — так точнее и быстрее." Style="{StaticResource Caption}" />
          </StackPanel>
          <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" />
        </Grid>
      </Border>
      <Border Style="{StaticResource Row}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Ядра процессора для расшифровки" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Больше — быстрее, но компьютер заметнее загружен. Пока идёт запись, новая расшифровка не начинается." Style="{StaticResource Caption}" />
          </StackPanel>
          <ComboBox Grid.Column="1" ItemsSource="{Binding ThreadOptions}" SelectedItem="{Binding Threads}" />
        </Grid>
      </Border>
      <Border Style="{StaticResource Row}">
        <DockPanel>
          <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding AutoTranscribe}" AutomationProperties.Name="Расшифровывать автоматически" />
          <StackPanel>
            <TextBlock Text="Расшифровывать после каждой записи" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Иначе — кнопкой «Расшифровать» в архиве." Style="{StaticResource Caption}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Storage -->
      <TextBlock Text="Хранение записей" Style="{StaticResource Group}" />
      <Border Style="{StaticResource Row}">
        <StackPanel>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <ui:Button Content="Открыть" Command="{Binding OpenArchiveCommand}" Margin="8,0,0,0" />
              <ui:Button Content="Изменить…" Command="{Binding ChooseArchiveCommand}" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Папка архива" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
              <TextBlock Text="{Binding ArchiveRoot}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding ArchiveRoot}" />
              <TextBlock Text="{Binding ArchiveSize}" Style="{StaticResource Caption}" />
            </StackPanel>
          </DockPanel>
          <ui:InfoBar Margin="0,10,0,0" IsOpen="{Binding ArchiveRestartNote, Converter={StaticResource IsSet}}" IsClosable="False" Severity="Warning"
                      Title="" Message="{Binding ArchiveRestartNote}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Row}">
        <DockPanel>
          <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding CompressAudio}" AutomationProperties.Name="Сжимать без потерь" />
          <StackPanel>
            <TextBlock Text="Сжимать звук без потерь после записи" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Дорожки переводятся из WAV в FLAC: звук тот же, места в 2–3 раза меньше. Во время записи файл остаётся WAV — его можно восстановить даже после сбоя."
                       Style="{StaticResource Caption}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Recording -->
      <TextBlock Text="Запись" Style="{StaticResource Group}" />
      <Border Style="{StaticResource Row}">
        <StackPanel>
          <DockPanel>
            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding GlobalHotkeys}" AutomationProperties.Name="Горячие клавиши" />
            <StackPanel>
              <TextBlock Text="Горячие клавиши в любой программе" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
              <TextBlock Style="{StaticResource Caption}">
                <Run Text="{Binding HotkeyToggle, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" — начать или завершить запись,  " /><Run Text="{Binding HotkeyBookmark, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" — поставить метку." />
              </TextBlock>
            </StackPanel>
          </DockPanel>
          <TextBlock Text="{Binding HotkeyConflicts}" FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                     Visibility="{Binding HotkeyConflicts, Converter={StaticResource VisibleIfSet}}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Row}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Частота кадров видео" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Для экрана и окон. Видео пишется видеокартой и почти не нагружает процессор." Style="{StaticResource Caption}" />
          </StackPanel>
          <ComboBox Grid.Column="1" ItemsSource="{Binding FpsOptions}" SelectedItem="{Binding Fps}" />
        </Grid>
      </Border>

      <!-- Chrome -->
      <TextBlock Text="Вкладки Chrome — до четырёх трансляций сразу" Style="{StaticResource Group}" />
      <Border Style="{StaticResource Row}">
        <StackPanel>
          <TextBlock Style="{StaticResource Caption}" FontSize="13" LineHeight="21">
            <Run Text="1. В Chrome откройте" /><Run Text=" chrome://extensions " FontWeight="SemiBold" /><Run Text="и включите «Режим разработчика» (справа вверху)." /><LineBreak />
            <Run Text="2. «Загрузить распакованное расширение» → выберите папку расширения (кнопка ниже)." /><LineBreak />
            <Run Text="3. Откройте расширение CallDock и вставьте код подключения." /><LineBreak />
            <Run Text="4. На вкладке с трансляцией нажмите «Записывать эту вкладку». Каждая вкладка — отдельная дорожка; для трёх-четырёх трансляций сразу выберите «Без видео»." /><LineBreak />
            <Run Text="5. После обновления CallDock нажмите ↻ у расширения на странице chrome://extensions." />
          </TextBlock>
          <WrapPanel Margin="0,12,0,0">
            <ui:Button Content="Скопировать chrome://extensions" Command="{Binding OpenChromeExtensionsCommand}" Margin="0,0,8,8" />
            <ui:Button Content="Открыть папку расширения" Command="{Binding OpenExtensionCommand}" Margin="0,0,8,8" />
          </WrapPanel>
          <DockPanel Margin="0,6,0,0">
            <ui:Button DockPanel.Dock="Right" Content="Скопировать код" Command="{Binding CopyTokenCommand}" Appearance="Primary" Margin="8,0,0,0" />
            <ui:Button DockPanel.Dock="Right" Command="{Binding ToggleTokenCommand}" Appearance="Transparent" Margin="8,0,0,0" ToolTip="Показать или скрыть код">
              <ui:Button.Icon><ui:SymbolIcon Symbol="Eye24" /></ui:Button.Icon>
            </ui:Button>
            <ui:TextBox Text="{Binding TokenDisplay, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas"
                        AutomationProperties.Name="Код подключения Chrome" />
          </DockPanel>
          <TextBlock Text="{Binding BridgeStatus}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
        </StackPanel>
      </Border>

      <!-- Appearance -->
      <TextBlock Text="Оформление" Style="{StaticResource Group}" />
      <Border Style="{StaticResource Row}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Тема" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" />
        </Grid>
      </Border>
      <Border Style="{StaticResource Row}">
        <DockPanel>
          <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding SoftwareRendering}" AutomationProperties.Name="Совместимая отрисовка" />
          <StackPanel>
            <TextBlock Text="Совместимая отрисовка окна" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Для компьютеров со старыми видеодрайверами, где окно остаётся белым или пустым. Включается и из меню значка в трее. На запись не влияет."
                       Style="{StaticResource Caption}" />
          </StackPanel>
        </DockPanel>
      </Border>
      <ui:InfoBar Margin="0,0,0,6" IsOpen="{Binding NeedsRestart}" IsClosable="False" Severity="Informational" Title=""
                  Message="Изменения вступят в силу после перезапуска CallDock." />
      <ui:Button Content="Перезапустить CallDock" Command="{Binding RestartCommand}" Margin="0,0,0,6" Visibility="{Binding NeedsRestart, Converter={StaticResource Visible}}" />

      <!-- Updates & about -->
      <TextBlock Text="Обновления" Style="{StaticResource Group}" />
      <Border Style="{StaticResource Row}">
        <StackPanel>
          <DockPanel>
            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding CheckForUpdates}" AutomationProperties.Name="Проверять обновления" />
            <StackPanel>
              <TextBlock Text="Проверять обновления при запуске" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
              <TextBlock Text="Новая версия скачивается в фоне и ставится при следующем запуске — никогда во время записи." Style="{StaticResource Caption}" />
            </StackPanel>
          </DockPanel>
          <WrapPanel Margin="0,12,0,0">
            <ui:Button Content="Проверить сейчас" Command="{Binding CheckUpdatesCommand}" Margin="0,0,8,0" />
            <ui:Button Content="Перезапустить и обновить" Command="{Binding RestartToUpdateCommand}" Appearance="Primary" Margin="0,0,8,0"
                       Visibility="{Binding CanRestart, Converter={StaticResource Visible}}" />
          </WrapPanel>
          <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Caption}" Margin="0,8,0,0" Visibility="{Binding UpdateStatus, Converter={StaticResource VisibleIfSet}}" />
        </StackPanel>
      </Border>

      <TextBlock Text="О программе" Style="{StaticResource Group}" />
      <Border Style="{StaticResource Row}">
        <DockPanel>
          <Image DockPanel.Dock="Left" Source="pack://application:,,,/Assets/logo-64.png" Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Top" />
          <StackPanel>
            <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}">
              <Run Text="CallDock " FontWeight="SemiBold" /><Run Text="{Binding Version, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="Запись звонков и трансляций с расшифровкой на вашем компьютере. Открытый код, лицензия MIT." Style="{StaticResource Caption}" />
            <WrapPanel Margin="0,10,0,0">
              <ui:Button Content="Страница проекта на GitHub" Command="{Binding OpenRepositoryCommand}" Margin="0,0,8,8" />
              <ui:Button Content="Лицензии компонентов" Command="{Binding OpenNoticesCommand}" Margin="0,0,8,8" />
              <ui:Button Content="Журнал работы" Command="{Binding OpenLogsCommand}" Margin="0,0,8,8" ToolTip="Пригодится, если что-то пошло не так" />
            </WrapPanel>
          </StackPanel>
        </DockPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
