<UserControl x:Class="CallDock.App.Views.ArchiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:CallDock.App.ViewModels"
             xmlns:views="clr-namespace:CallDock.App.Views">
  <UserControl.Resources>
    <CollectionViewSource x:Key="Sessions" Source="{Binding Items}">
      <CollectionViewSource.GroupDescriptions>
        <PropertyGroupDescription PropertyName="DayGroup" />
      </CollectionViewSource.GroupDescriptions>
    </CollectionViewSource>

    <Style x:Key="ToneDot" TargetType="Ellipse">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StatusTone.Success}">
          <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StatusTone.Busy}">
          <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StatusTone.Warning}">
          <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StatusTone.Error}">
          <Setter Property="Fill" Value="{StaticResource RecordBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="360" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- The list. -->
    <Grid Grid.RowSpan="2" Margin="22,22,14,14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
        <TextBlock Text="Архив" Style="{StaticResource PageTitle}" />
      </DockPanel>
      <ui:TextBox Grid.Row="1" Margin="0,14,0,12" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="True"
                  PlaceholderText="Найти по названию, проекту или фразе" AutomationProperties.Name="Поиск по архиву">
        <ui:TextBox.Icon><ui:SymbolIcon Symbol="Search24" /></ui:TextBox.Icon>
      </ui:TextBox>
      <ListBox Grid.Row="2" x:Name="SessionList" ItemsSource="{Binding Source={StaticResource Sessions}}" SelectedItem="{Binding Selected}"
               BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel"
               AutomationProperties.Name="Записи">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem" BasedOn="{StaticResource SoftListItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" Style="{StaticResource Eyebrow}" Margin="6,14,0,6" />
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ListBox.GroupStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="2,4">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
              <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Ellipse Style="{StaticResource ToneDot}" />
                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:SymbolIcon Symbol="Video24" FontSize="12" Margin="8,0,0,0" ToolTip="Есть видео"
                               Visibility="{Binding HasVideo, Converter={StaticResource Visible}}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Grid.Row="2" Text="{Binding EmptyText}" Style="{StaticResource Caption}" FontSize="13" Margin="6,8,6,0" VerticalAlignment="Top"
                 Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
      <ui:Button Grid.Row="3" Content="Показать ещё" Command="{Binding LoadMoreCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                 Visibility="{Binding HasMore, Converter={StaticResource Visible}}" />
    </Grid>

    <Border Grid.Column="1" Grid.RowSpan="2" Width="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

    <!-- Nothing selected. -->
    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40"
                Visibility="{Binding Detail, Converter={StaticResource HiddenIfSet}}">
      <ui:SymbolIcon Symbol="Archive24" FontSize="44" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
      <TextBlock Text="Выберите запись слева" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,14,0,6" />
      <TextBlock Text="Здесь будут расшифровка с таймкодами, отдельные дорожки, метки и заметки. Щелчок по фразе включает её звук."
                 Style="{StaticResource Caption}" TextAlignment="Center" MaxWidth="380" />
    </StackPanel>

    <!-- The open recording. -->
    <Grid Grid.Column="2" DataContext="{Binding Detail}" Visibility="{Binding Converter={StaticResource VisibleIfSet}}" Margin="22,18,22,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel>
        <TextBox Style="{StaticResource InlineEdit}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}" FontSize="22" FontWeight="SemiBold"
                 MaxLength="240" AutomationProperties.Name="Название записи" ToolTip="Название — щёлкните, чтобы изменить" />
        <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}" Margin="0,4,0,12" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ui:TextBox Text="{Binding Project, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}" PlaceholderText="Проект" MaxLength="160">
            <ui:TextBox.Icon><ui:SymbolIcon Symbol="Folder24" /></ui:TextBox.Icon>
          </ui:TextBox>
          <ui:TextBox Grid.Column="2" Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}" PlaceholderText="Теги через запятую" MaxLength="500">
            <ui:TextBox.Icon><ui:SymbolIcon Symbol="Tag24" /></ui:TextBox.Icon>
          </ui:TextBox>
        </Grid>
        <WrapPanel Margin="0,12,0,0">
          <ui:Button Content="Слушать" Command="{Binding ListenCommand}" Appearance="Primary" Margin="0,0,8,8">
            <ui:Button.Icon><ui:SymbolIcon Symbol="Play24" /></ui:Button.Icon>
          </ui:Button>
          <ui:Button Content="{Binding TranscribeButtonText}" Command="{Binding TranscribeCommand}" Margin="0,0,8,8">
            <ui:Button.Icon><ui:SymbolIcon Symbol="ClosedCaption24" /></ui:Button.Icon>
          </ui:Button>
          <ui:Button x:Name="ExportButton" Content="Сохранить как…" Click="OpenExportMenu" Margin="0,0,8,8">
            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowDownload24" /></ui:Button.Icon>
          </ui:Button>
          <ui:Button Content="Папка" Command="{Binding OpenFolderCommand}" Margin="0,0,8,8" ToolTip="Открыть папку записи в Проводнике">
            <ui:Button.Icon><ui:SymbolIcon Symbol="FolderOpen24" /></ui:Button.Icon>
          </ui:Button>
          <ui:Button Command="{Binding DeleteCommand}" Appearance="Transparent" Margin="0,0,8,8" ToolTip="Удалить запись (в Корзину)"
                     IsEnabled="{Binding IsReadOnly, Converter={StaticResource Not}}" AutomationProperties.Name="Удалить запись">
            <ui:Button.Icon><ui:SymbolIcon Symbol="Delete24" /></ui:Button.Icon>
          </ui:Button>
        </WrapPanel>
      </StackPanel>

      <ui:InfoBar Grid.Row="1" Margin="0,4,0,8" IsClosable="False" Title="" Message="{Binding Banner}" Severity="{Binding BannerSeverity}"
                  IsOpen="{Binding Banner, Converter={StaticResource IsSet}}" />

      <Border Grid.Row="2" Style="{StaticResource Surface}" Padding="14,10" Margin="0,0,0,8"
              Visibility="{Binding IsProcessing, Converter={StaticResource Visible}}">
        <DockPanel>
          <ui:Button DockPanel.Dock="Right" Content="Отменить" Command="{Binding CancelProcessingCommand}" Appearance="Transparent" Margin="10,0,0,0" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding ProcessingText}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <ProgressBar Margin="0,6,0,0" Height="4" Maximum="100" Value="{Binding ProcessingFraction}" IsIndeterminate="{Binding ProcessingIndeterminate}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <TabControl Grid.Row="3" Margin="0,4,0,0">
        <TabItem Header="Расшифровка">
          <Grid Margin="0,10,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Visibility="{Binding HasTranscript, Converter={StaticResource Visible}}" Margin="0,0,0,8">
              <ui:Button DockPanel.Dock="Right" Content="Копировать текст" Command="{Binding CopyTranscriptCommand}" Margin="8,0,0,0">
                <ui:Button.Icon><ui:SymbolIcon Symbol="Copy24" /></ui:Button.Icon>
              </ui:Button>
              <ui:TextBox Text="{Binding TranscriptFilter, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Найти в разговоре" ClearButtonEnabled="True">
                <ui:TextBox.Icon><ui:SymbolIcon Symbol="Search24" /></ui:TextBox.Icon>
              </ui:TextBox>
            </DockPanel>
            <TextBlock Grid.Row="1" Text="{Binding TranscriptHint}" Style="{StaticResource Caption}" FontSize="13" Margin="2,6,0,0"
                       Visibility="{Binding HasTranscript, Converter={StaticResource Hidden}}" />
            <ListBox Grid.Row="1" x:Name="TranscriptList" ItemsSource="{Binding TranscriptRows}" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"
                     Visibility="{Binding HasTranscript, Converter={StaticResource Visible}}" AutomationProperties.Name="Расшифровка">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource TranscriptRow}">
                  <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Button Appearance="Transparent" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Top" ToolTip="Слушать с этого места"
                               AutomationProperties.Name="{Binding Time, StringFormat='Слушать с {0}'}"
                               Command="{Binding DataContext.PlayRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                      <TextBlock Text="{Binding Time}" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                    </ui:Button>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Source}" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2,0,0" FontSize="14" LineHeight="21"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </TabItem>

        <TabItem Header="Дорожки">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <ItemsControl ItemsSource="{Binding Tracks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Surface}" Padding="14,10" Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="20" Margin="0,0,14,0" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding Error}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   Visibility="{Binding Error, Converter={StaticResource VisibleIfSet}}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="Слушать" Margin="8,0,0,0" Visibility="{Binding CanListen, Converter={StaticResource Visible}}"
                                   Command="{Binding DataContext.ListenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                        <ui:Button Content="Смотреть" Margin="8,0,0,0" Visibility="{Binding CanWatch, Converter={StaticResource Visible}}"
                                   Command="{Binding DataContext.WatchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                        <ui:Button Content="Сохранить…" Margin="8,0,0,0"
                                   Command="{Binding DataContext.ExportTrackCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Метки">
          <Grid Margin="0,10,0,0">
            <TextBlock Text="Меток нет. Во время записи нажмите «Метка» или Ctrl+Alt+M — момент отметится здесь." Style="{StaticResource Caption}" FontSize="13"
                       Visibility="{Binding Bookmarks.Count, Converter={StaticResource CountToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Bookmarks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,0,0,6">
                    <ui:Button Appearance="Transparent" Padding="6,2" Margin="0,0,10,0" ToolTip="Слушать с этого места"
                               AutomationProperties.Name="{Binding Time, StringFormat='Слушать с {0}'}"
                               Command="{Binding DataContext.PlayBookmarkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                      <TextBlock Text="{Binding Time}" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                    </ui:Button>
                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </TabItem>

        <TabItem Header="Заметки">
          <TextBox Margin="0,10,0,0" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}" AcceptsReturn="True"
                   TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" MinHeight="160"
                   AutomationProperties.Name="Заметки" ToolTip="Решения, договорённости, задачи — сохраняются сами и ищутся в архиве" />
        </TabItem>
      </TabControl>

      <Border Grid.Row="4" Style="{StaticResource Surface}" Padding="12,8" Margin="0,8,0,14"
              Visibility="{Binding IsExporting, Converter={StaticResource Visible}}">
        <DockPanel>
          <ui:Button DockPanel.Dock="Right" Content="Отменить" Command="{Binding CancelExportCommand}" Appearance="Transparent" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding ExportText}" FontSize="12" />
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,6,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>

    <views:PlayerBar x:Name="Player" Grid.Row="1" Grid.Column="2" Margin="22,0,22,14" Visibility="Collapsed" />
  </Grid>
</UserControl>
