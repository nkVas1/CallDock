<UserControl x:Class="CallDock.App.Views.PlayerBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <Border Style="{StaticResource Surface}" Padding="10,8">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <MediaElement x:Name="Media" Width="0" Height="0" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                    MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded" MediaFailed="OnMediaFailed" />
      <ui:Button x:Name="PlayButton" Click="TogglePlay" Appearance="Primary" Padding="10,6" AutomationProperties.Name="Пуск или пауза" ToolTip="Пуск / пауза">
        <ui:Button.Icon><ui:SymbolIcon x:Name="PlayIcon" Symbol="Pause24" Filled="True" /></ui:Button.Icon>
      </ui:Button>
      <ui:Button Grid.Column="1" Click="Back" Appearance="Transparent" Padding="8,6" Margin="6,0,0,0" ToolTip="Назад на 10 секунд" AutomationProperties.Name="Назад на 10 секунд">
        <ui:Button.Icon><ui:SymbolIcon Symbol="SkipBack1024" /></ui:Button.Icon>
      </ui:Button>
      <ui:Button Grid.Column="2" Click="Forward" Appearance="Transparent" Padding="8,6" ToolTip="Вперёд на 10 секунд" AutomationProperties.Name="Вперёд на 10 секунд">
        <ui:Button.Icon><ui:SymbolIcon Symbol="SkipForward1024" /></ui:Button.Icon>
      </ui:Button>
      <TextBlock Grid.Column="3" x:Name="TimeText" Text="00:00:00" Margin="10,0,12,0" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas"
                 FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
      <Slider Grid.Column="4" x:Name="Position" VerticalAlignment="Center" IsMoveToPointEnabled="True"
              Thumb.DragStarted="DragStarted" Thumb.DragCompleted="DragCompleted" PreviewMouseLeftButtonUp="SliderClicked"
              AutomationProperties.Name="Позиция" />
      <StackPanel Grid.Column="5" Margin="12,0,6,0" VerticalAlignment="Center" MaxWidth="220">
        <TextBlock x:Name="TrackText" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBlock x:Name="NoteText" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource VisibleIfSet}}" />
      </StackPanel>
      <ui:Button Grid.Column="6" Click="Close" Appearance="Transparent" Padding="8,6" ToolTip="Закрыть плеер" AutomationProperties.Name="Закрыть плеер">
        <ui:Button.Icon><ui:SymbolIcon Symbol="Dismiss24" /></ui:Button.Icon>
      </ui:Button>
    </Grid>
  </Border>
</UserControl>
